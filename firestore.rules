// Қолданба Firestore-ға тек сервер (Admin SDK) арқылы кіреді — Admin SDK ережелерді айналып өтеді.
// Сондықтан браузерден тікелей кіруді толық жабамыз.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
